{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KLineForge",
  "version": "0.1.0-tauri",
  "identifier": "dev.klineforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KLineForge",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "High-performance local crypto charting.",
    "longDescription": "KLineForge is a Tauri/Rust desktop-first crypto charting application for Binance public market data."
  }
}
