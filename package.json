{
  "name": "klineforge",
  "version": "0.1.0-tauri",
  "private": true,
  "type": "module",
  "desktopName": "KLineForge",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:bundle": "tauri build",
    "desktop:dev": "npm run tauri:dev",
    "desktop:build": "npm run tauri:build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "benchmark:real": "cargo run --manifest-path src-tauri/Cargo.toml --bin klineforge-benchmark -- --output artifacts/performance/latest-benchmark.json",
    "benchmark:archive:100k": "cargo run --manifest-path src-tauri/Cargo.toml --bin klineforge-benchmark -- --archive-target 100000 --output artifacts/performance/archive-100k-benchmark.json",
    "benchmark:archive:1m": "cargo run --manifest-path src-tauri/Cargo.toml --bin klineforge-benchmark -- --archive-target 1000000 --output artifacts/performance/archive-1m-benchmark.json",
    "verify:market-data": "cargo run --manifest-path src-tauri/Cargo.toml --bin klineforge-market-smoke -- --output artifacts/performance/market-data-smoke.json",
    "verify:full-history": "cargo run --manifest-path src-tauri/Cargo.toml --bin klineforge-full-history -- --market usdM --symbol BTCUSDT --interval 1h --output artifacts/performance/full-history-usdm-btcusdt-1h.json",
    "prepare:chart-dataset:100k": "cargo run --manifest-path src-tauri/Cargo.toml --bin klineforge-benchmark -- --archive-target 100000 --with-indicators --output artifacts/performance/archive-100k-benchmark.json --chart-dataset-output artifacts/performance/chart-dataset-100k.json",
    "prepare:chart-dataset:1m": "cargo run --manifest-path src-tauri/Cargo.toml --bin klineforge-benchmark -- --archive-target 1000000 --output artifacts/performance/archive-1m-benchmark.json --chart-dataset-output artifacts/performance/chart-dataset-1m.json",
    "verify:render": "node scripts/verify-tauri-render.mjs",
    "verify:indicator-instances": "node scripts/verify-indicator-instances.mjs",
    "verify:independent-chart-viewports": "node scripts/verify-independent-chart-viewports.mjs",
    "verify:workspace-scroll": "node scripts/verify-workspace-scroll.mjs",
    "verify:large-chart:100k": "node scripts/verify-large-chart-interaction.mjs http://127.0.0.1:4173/ 100000",
    "verify:large-chart:1m": "node scripts/verify-large-chart-interaction.mjs http://127.0.0.1:4173/ 1000000"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lightweight-charts": "5.2.0",
    "solid-js": "1.9.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.8",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "undici": "7.28.0"
  }
}
